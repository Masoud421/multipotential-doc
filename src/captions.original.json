[
  {
    "start": 0.378,
    "end": 2.552,
    "text": "تا حالا شده یه کلاس گیتار بری"
  },
  {
    "start": 2.592,
    "end": 4.59,
    "text": "دو هفته بعد سراغ برنامه‌نویسی"
  },
  {
    "start": 4.63,
    "end": 6.856,
    "text": "بعدش نقاشی، و آخرش با خودت بگی"
  },
  {
    "start": 6.896,
    "end": 9.076,
    "text": "من چرا هیچ‌چیز رو تموم نمی‌کنم؟"
  },
  {
    "start": 9.554,
    "end": 11.516,
    "text": "شاید مشکل تو علاقه‌هات نیست"
  },
  {
    "start": 11.664,
    "end": 13.709,
    "text": "شاید مشکل اینه که هیچ‌وقت نسنجیدی"
  },
  {
    "start": 13.749,
    "end": 15.816,
    "text": "کدومشون واقعا به دردت می‌خوره"
  },
  {
    "start": 16.294,
    "end": 18.193,
    "text": "تا آخر این ویدیو سه تا معیار"
  },
  {
    "start": 18.233,
    "end": 20.705,
    "text": "ساده یاد می‌گیری که\nبفهمی علاقه‌های زیادت"
  },
  {
    "start": 20.745,
    "end": 23.081,
    "text": "دارن کمکت می‌کنن یا زمین‌گیرت کردن"
  },
  {
    "start": 23.228,
    "end": 25.704,
    "text": "بعدش روش بنجامین\nفرانکلین رو می‌بینیم"
  },
  {
    "start": 25.744,
    "end": 27.872,
    "text": "که می‌تونی همین هفته شروع کنی"
  },
  {
    "start": 28.019,
    "end": 28.854,
    "text": "و در آخر"
  },
  {
    "start": 28.894,
    "end": 30.462,
    "text": "چهار مدل کاری رو می‌شناسی"
  },
  {
    "start": 30.502,
    "end": 32.351,
    "text": "که مخصوص آدمای چندعلاقه‌ست"
  },
  {
    "start": 32.829,
    "end": 34.21,
    "text": "به سرک خوش اومدی"
  },
  {
    "start": 34.357,
    "end": 35.302,
    "text": "بریم سراغش"
  },
  {
    "start": 36.112,
    "end": 37.596,
    "text": "اینجا یه تناقض هست"
  },
  {
    "start": 37.743,
    "end": 39.933,
    "text": "همه می‌گن روی یه چیز تمرکز کن"
  },
  {
    "start": 40.08,
    "end": 41.87,
    "text": "ولی با پیشرفت هوش مصنوعی"
  },
  {
    "start": 41.91,
    "end": 44.402,
    "text": "دقیقا مهارت‌های\nترکیبی دارن مهم می‌شن"
  },
  {
    "start": 44.55,
    "end": 47.669,
    "text": "طبق گزارش مجمع جهانی\nاقتصاد درباره آینده مشاغل"
  },
  {
    "start": 47.709,
    "end": 49.079,
    "text": "تا سال دو هزار و سی"
  },
  {
    "start": 49.119,
    "end": 50.54,
    "text": "حدود سی و نه درصد از"
  },
  {
    "start": 50.58,
    "end": 52.854,
    "text": "مهارت‌های کلیدی\nشغل‌ها تغییر می‌کنه"
  },
  {
    "start": 53.333,
    "end": 56.104,
    "text": "ولی این یعنی باید\nهمه‌چیز رو یاد بگیری؟"
  },
  {
    "start": 56.251,
    "end": 56.826,
    "text": "نه"
  },
  {
    "start": 56.866,
    "end": 59.465,
    "text": "بین کسی که ده تا\nعلاقه نیمه‌کاره داره"
  },
  {
    "start": 59.505,
    "end": 61.508,
    "text": "و کسی که از ترکیب همون علاقه‌ها"
  },
  {
    "start": 61.548,
    "end": 63.556,
    "text": "یه مهارت تازه و کمیاب ساخته"
  },
  {
    "start": 63.596,
    "end": 64.863,
    "text": "یه دنیا فاصله‌ست"
  },
  {
    "start": 65.342,
    "end": 66.774,
    "text": "پس سؤال اصلی اینه"
  },
  {
    "start": 66.921,
    "end": 68.802,
    "text": "از کجا بفهمیم علاقه‌های زیادمون"
  },
  {
    "start": 68.842,
    "end": 70.84,
    "text": "دارن پیشرفتمون رو خراب می‌کنن"
  },
  {
    "start": 70.88,
    "end": 73.154,
    "text": "یا می‌تونن بزرگ‌ترین مزیتمون باشن؟"
  },
  {
    "start": 73.633,
    "end": 74.785,
    "text": "اگه هر بار که یه"
  },
  {
    "start": 74.825,
    "end": 76.294,
    "text": "چیز جذاب پیدا می‌کنی"
  },
  {
    "start": 76.334,
    "end": 79.089,
    "text": "چند ماه بذاری تا بفهمی\nواقعا دوستش داری"
  },
  {
    "start": 79.129,
    "end": 80.292,
    "text": "نصف عمرت می‌ره"
  },
  {
    "start": 80.439,
    "end": 81.96,
    "text": "به جای شمردن علاقه‌ها"
  },
  {
    "start": 82.0,
    "end": 83.412,
    "text": "باید ببینی از هر کدوم"
  },
  {
    "start": 83.452,
    "end": 84.78,
    "text": "چی به دست می‌اری"
  },
  {
    "start": 84.927,
    "end": 86.136,
    "text": "و برای این کار"
  },
  {
    "start": 86.176,
    "end": 87.505,
    "text": "سه تا معیار هست"
  },
  {
    "start": 88.314,
    "end": 89.214,
    "text": "معیار اول"
  },
  {
    "start": 89.355,
    "end": 90.937,
    "text": "خود کار رو دوست داری"
  },
  {
    "start": 90.977,
    "end": 93.426,
    "text": "یا فقط نتیجه‌ای که\nازش تصور می‌کنی؟"
  },
  {
    "start": 93.905,
    "end": 96.277,
    "text": "کال نیوپورت، نویسنده کتاب کار عمیق"
  },
  {
    "start": 96.317,
    "end": 98.974,
    "text": "یه کتاب دیگه داره که\nحرفش بحث‌برانگیزه"
  },
  {
    "start": 99.121,
    "end": 101.831,
    "text": "اونقدر خوب باش که\nنتونن نادیده‌ات بگیرن"
  },
  {
    "start": 101.978,
    "end": 105.046,
    "text": "می‌گه توصیه «دنبال علاقه‌ات\nبرو» همیشه جواب نمی‌ده"
  },
  {
    "start": 105.086,
    "end": 107.089,
    "text": "و رضایت شغلی توی خیلی از موارد"
  },
  {
    "start": 107.129,
    "end": 109.563,
    "text": "بعد از ساختن یه\nمهارت ارزشمند می‌اد"
  },
  {
    "start": 109.603,
    "end": 110.499,
    "text": "نه قبلش"
  },
  {
    "start": 110.539,
    "end": 113.242,
    "text": "پس به جای اینکه دنبال\nشغل ایده‌آل بگردی"
  },
  {
    "start": 113.282,
    "end": 115.12,
    "text": "ببین چطور می‌تونی توی کاری که"
  },
  {
    "start": 115.16,
    "end": 116.966,
    "text": "الان داری واقعا خوب بشی"
  },
  {
    "start": 117.445,
    "end": 119.251,
    "text": "یه آزمایش ساده بهت می‌دم"
  },
  {
    "start": 119.398,
    "end": 121.422,
    "text": "فرض کن به عکاسی علاقه داری"
  },
  {
    "start": 121.569,
    "end": 123.667,
    "text": "یه هفته ویدیوهای آموزشی و پشت‌صحنه"
  },
  {
    "start": 123.707,
    "end": 125.601,
    "text": "عکاس‌های معروف رو بذار کنار"
  },
  {
    "start": 125.641,
    "end": 127.053,
    "text": "و واقعا یه مجموعه عکس"
  },
  {
    "start": 127.093,
    "end": 128.743,
    "text": "کوتاه بگیر و ادیت کن"
  },
  {
    "start": 128.891,
    "end": 130.522,
    "text": "نتیجه‌ش احتمالا افتضاحه"
  },
  {
    "start": 130.669,
    "end": 132.034,
    "text": "نور خراب، کادر کج"
  },
  {
    "start": 132.074,
    "end": 133.88,
    "text": "ساعت‌ها گیر یه ادیت ساده"
  },
  {
    "start": 134.027,
    "end": 135.729,
    "text": "آخر هفته از خودت بپرس"
  },
  {
    "start": 135.876,
    "end": 137.34,
    "text": "با اینکه سخت‌تر از چیزی"
  },
  {
    "start": 137.38,
    "end": 138.745,
    "text": "بود که فکر می‌کردم"
  },
  {
    "start": 138.785,
    "end": 140.965,
    "text": "هنوز دلم می‌خواد توش بهتر بشم؟"
  },
  {
    "start": 141.443,
    "end": 143.675,
    "text": "لازم نیست عاشق همه بخش‌هاش باشی"
  },
  {
    "start": 143.822,
    "end": 146.034,
    "text": "ولی اگه فقط دیدن\nزندگی عکاس‌ها برات"
  },
  {
    "start": 146.074,
    "end": 148.351,
    "text": "جذابه و از کار واقعی فرار می‌کنی"
  },
  {
    "start": 148.391,
    "end": 149.98,
    "text": "شاید بهتره عجله نکنی"
  },
  {
    "start": 150.789,
    "end": 151.689,
    "text": "معیار دوم"
  },
  {
    "start": 151.83,
    "end": 153.74,
    "text": "علاقه‌هات به هم کمک می‌کنن؟"
  },
  {
    "start": 154.218,
    "end": 156.643,
    "text": "امیلی واپنیک، توی\nسخنرانی تد معروفش"
  },
  {
    "start": 156.683,
    "end": 158.147,
    "text": "به آدمایی که چند علاقه"
  },
  {
    "start": 158.187,
    "end": 160.295,
    "text": "همزمان دارن می‌گه مولتی‌پوتنشیال"
  },
  {
    "start": 160.443,
    "end": 162.607,
    "text": "یکی از توانایی‌های مهم این آدما"
  },
  {
    "start": 162.647,
    "end": 163.644,
    "text": "ترکیب کردنه"
  },
  {
    "start": 163.791,
    "end": 165.733,
    "text": "یعنی دانش چند حوزه رو برمیدارن"
  },
  {
    "start": 165.773,
    "end": 167.423,
    "text": "و یه چیز تازه می‌سازن"
  },
  {
    "start": 167.57,
    "end": 168.987,
    "text": "مثلا کسی که موسیقی"
  },
  {
    "start": 169.027,
    "end": 171.295,
    "text": "برنامه‌نویسی و طراحی رو دوست داره"
  },
  {
    "start": 171.335,
    "end": 174.419,
    "text": "می‌تونه یه اپ کوچیک برای\nیادگیری موسیقی بسازه"
  },
  {
    "start": 174.566,
    "end": 175.978,
    "text": "هر سه مهارتش توی همون"
  },
  {
    "start": 176.018,
    "end": 177.591,
    "text": "یه پروژه استفاده می‌شه"
  },
  {
    "start": 177.631,
    "end": 178.518,
    "text": "و هر کدوم"
  },
  {
    "start": 178.558,
    "end": 180.26,
    "text": "اون یکی رو بهتر می‌کنه"
  },
  {
    "start": 180.738,
    "end": 182.606,
    "text": "ولی یه حالت دیگه هم هست"
  },
  {
    "start": 182.753,
    "end": 183.952,
    "text": "این ماه کدنویسی"
  },
  {
    "start": 183.992,
    "end": 185.087,
    "text": "ماه بعد گیتار"
  },
  {
    "start": 185.127,
    "end": 186.933,
    "text": "بعدش نقاشی، و آخرش بورس"
  },
  {
    "start": 187.081,
    "end": 188.721,
    "text": "تا اینجا ایرادی نداره"
  },
  {
    "start": 188.869,
    "end": 190.716,
    "text": "ولی اگه هر بار همه‌چیز رو ول"
  },
  {
    "start": 190.756,
    "end": 192.759,
    "text": "می‌کنی و از چیزایی که یاد گرفتی"
  },
  {
    "start": 192.799,
    "end": 194.798,
    "text": "توی مسیر بعدی استفاده نمی‌کنی"
  },
  {
    "start": 194.838,
    "end": 196.27,
    "text": "یه جای کار می‌لنگه"
  },
  {
    "start": 196.748,
    "end": 197.85,
    "text": "تمرینش ساده‌ست"
  },
  {
    "start": 197.997,
    "end": 199.253,
    "text": "یه کاغذ بردار و سه"
  },
  {
    "start": 199.293,
    "end": 201.099,
    "text": "تا علاقه اصلیت رو بنویس"
  },
  {
    "start": 201.246,
    "end": 203.198,
    "text": "بعد یه پروژه کوچیک پیدا کن که"
  },
  {
    "start": 203.238,
    "end": 205.417,
    "text": "حداقل دوتاشون توش به کار بیاد"
  },
  {
    "start": 205.565,
    "end": 207.205,
    "text": "لازم نیست پولساز باشه"
  },
  {
    "start": 207.352,
    "end": 209.129,
    "text": "فقط می‌خوای ببینی علاقه‌هات به"
  },
  {
    "start": 209.169,
    "end": 210.663,
    "text": "هم ربط دارن یا نه"
  },
  {
    "start": 211.141,
    "end": 212.501,
    "text": "اگه تا اینجا حس کردی"
  },
  {
    "start": 212.541,
    "end": 214.435,
    "text": "دارم درباره خودت حرف می‌زنم"
  },
  {
    "start": 214.475,
    "end": 215.534,
    "text": "لایک رو بزن"
  },
  {
    "start": 215.682,
    "end": 217.841,
    "text": "یه لایک کوچیک کمک می‌کنه این ویدیو"
  },
  {
    "start": 217.881,
    "end": 220.113,
    "text": "به آدمای پرعلاقه‌ی دیگه هم برسه"
  },
  {
    "start": 220.26,
    "end": 222.585,
    "text": "و بمون، چون معیار\nسوم از همه سخت‌تره"
  },
  {
    "start": 222.625,
    "end": 225.178,
    "text": "و بیشتر آدما دقیقا\nهمین‌جا گیر می‌کنن"
  },
  {
    "start": 225.988,
    "end": 226.888,
    "text": "معیار سوم"
  },
  {
    "start": 227.028,
    "end": 228.923,
    "text": "وقتی هیجان اولیه تموم می‌شه"
  },
  {
    "start": 228.963,
    "end": 230.282,
    "text": "چه اتفاقی می‌فته؟"
  },
  {
    "start": 230.76,
    "end": 232.394,
    "text": "ست گادین توی کتاب شیب"
  },
  {
    "start": 232.434,
    "end": 234.915,
    "text": "از دوره‌ای حرف می‌زنه\nکه پیشرفت کند می‌شه"
  },
  {
    "start": 234.955,
    "end": 237.197,
    "text": "و آدم حس می‌کنه دیگه جلو نمی‌ره"
  },
  {
    "start": 237.344,
    "end": 238.828,
    "text": "اسمش رو می‌ذاره شیب"
  },
  {
    "start": 238.976,
    "end": 241.523,
    "text": "می‌گه هر مسیری یه\nجایی وارد شیب می‌شه"
  },
  {
    "start": 241.563,
    "end": 244.178,
    "text": "و باید یاد بگیری\nآگاهانه ازش رد بشی"
  },
  {
    "start": 244.656,
    "end": 246.878,
    "text": "اینجا برای آدم چندعلاقه خطرناکه"
  },
  {
    "start": 247.026,
    "end": 249.251,
    "text": "چون هر بار که یادگیری سخت می‌شه"
  },
  {
    "start": 249.291,
    "end": 251.181,
    "text": "یه علاقه جدید کنارش منتظره که"
  },
  {
    "start": 251.221,
    "end": 253.027,
    "text": "هنوز قسمت سختش رو ندیدی"
  },
  {
    "start": 253.174,
    "end": 254.181,
    "text": "و تو می‌پری"
  },
  {
    "start": 254.328,
    "end": 255.439,
    "text": "شاخه به شاخه"
  },
  {
    "start": 255.918,
    "end": 258.532,
    "text": "برای تشخیص، از خودت\nدو تا سؤال بپرس"
  },
  {
    "start": 258.68,
    "end": 261.331,
    "text": "اول، توی این مسیر\nچیز جدیدی یاد گرفتم"
  },
  {
    "start": 261.371,
    "end": 262.482,
    "text": "حتی اگه کند؟"
  },
  {
    "start": 262.629,
    "end": 265.271,
    "text": "دوم، دلیل مشخصی برای\nکنار گذاشتنش دارم"
  },
  {
    "start": 265.311,
    "end": 267.5,
    "text": "یا فقط از سخت شدنش خسته شدم؟"
  },
  {
    "start": 267.978,
    "end": 268.878,
    "text": "ساده بگم"
  },
  {
    "start": 268.967,
    "end": 270.866,
    "text": "اگه سه ماهه روی یه مهارت کار"
  },
  {
    "start": 270.906,
    "end": 273.288,
    "text": "می‌کنی و این اواخر پیشرفتت کند شده"
  },
  {
    "start": 273.328,
    "end": 276.255,
    "text": "همین به‌تنهایی دلیل\nخوبی برای ول کردن نیست"
  },
  {
    "start": 276.402,
    "end": 278.727,
    "text": "ولی اگه بعد از تجربه\nواقعی دیدی این"
  },
  {
    "start": 278.767,
    "end": 280.889,
    "text": "کار با شرایط و هدفت جور نیست"
  },
  {
    "start": 280.929,
    "end": 282.621,
    "text": "کنار گذاشتنش شکست نیست"
  },
  {
    "start": 283.431,
    "end": 285.081,
    "text": "پس سه تا معیار داریم"
  },
  {
    "start": 285.228,
    "end": 286.692,
    "text": "یک، خود فرآیند رو دوست"
  },
  {
    "start": 286.732,
    "end": 288.486,
    "text": "داری یا فقط نتیجه‌ش رو؟"
  },
  {
    "start": 288.633,
    "end": 290.813,
    "text": "دو، علاقه‌هات به هم کمک می‌کنن؟"
  },
  {
    "start": 290.96,
    "end": 292.699,
    "text": "سه، وقتی توی شیب افتادی"
  },
  {
    "start": 292.739,
    "end": 294.379,
    "text": "دلیل ادامه دادنت چیه؟"
  },
  {
    "start": 294.858,
    "end": 296.56,
    "text": "ولی یه چیز هنوز مونده"
  },
  {
    "start": 296.707,
    "end": 298.379,
    "text": "خیلی از آدما ساعت‌ها درباره"
  },
  {
    "start": 298.419,
    "end": 299.836,
    "text": "یه موضوع حرف می‌زنن"
  },
  {
    "start": 299.876,
    "end": 301.652,
    "text": "بهترین منابعش رو معرفی می‌کنن"
  },
  {
    "start": 301.692,
    "end": 303.274,
    "text": "و حتی فکر می‌کنن بلدن"
  },
  {
    "start": 303.314,
    "end": 304.518,
    "text": "در حالی که یه بار"
  },
  {
    "start": 304.558,
    "end": 306.104,
    "text": "هم دست به کار نشدن"
  },
  {
    "start": 306.252,
    "end": 307.612,
    "text": "بین «فکر می‌کنم بلدم» و"
  },
  {
    "start": 307.652,
    "end": 309.614,
    "text": "«واقعا بلدم» یه دنیا فاصله‌ست"
  },
  {
    "start": 310.092,
    "end": 312.9,
    "text": "و برای کسی که همین‌طور\nبین علاقه‌ها می‌چرخه"
  },
  {
    "start": 312.94,
    "end": 314.258,
    "text": "بهترین الگو کیه؟"
  },
  {
    "start": 314.406,
    "end": 315.663,
    "text": "بنجامین فرانکلین"
  },
  {
    "start": 315.81,
    "end": 317.025,
    "text": "بذار نشونت بدم"
  },
  {
    "start": 317.835,
    "end": 320.093,
    "text": "وقتی زندگی‌نامه\nفرانکلین رو می‌خونی"
  },
  {
    "start": 320.133,
    "end": 322.179,
    "text": "مدام باید برگردی ببینی درباره یه"
  },
  {
    "start": 322.219,
    "end": 324.139,
    "text": "نفر حرف می‌زنی یا چند نفر"
  },
  {
    "start": 324.286,
    "end": 326.067,
    "text": "نویسنده بود، چاپ‌کننده بود"
  },
  {
    "start": 326.107,
    "end": 328.791,
    "text": "طنزنویس بود، روی\nالکتریسیته آزمایش می‌کرد"
  },
  {
    "start": 328.831,
    "end": 330.248,
    "text": "چند تا اختراع داره"
  },
  {
    "start": 330.288,
    "end": 333.319,
    "text": "دیپلمات بود و یکی از\nپدران بنیان‌گذار آمریکا"
  },
  {
    "start": 333.798,
    "end": 335.38,
    "text": "با این همه کار بی‌ربط"
  },
  {
    "start": 335.42,
    "end": 337.122,
    "text": "یه سؤال جالب پیش می‌اد"
  },
  {
    "start": 337.269,
    "end": 339.66,
    "text": "چطور می‌شه روی چند تا چیز کار کرد"
  },
  {
    "start": 339.7,
    "end": 341.486,
    "text": "بدون اینکه همه عمرت بپری از"
  },
  {
    "start": 341.526,
    "end": 343.228,
    "text": "این شاخه به اون شاخه؟"
  },
  {
    "start": 343.707,
    "end": 345.451,
    "text": "اینجا فرانکلین زرنگ بود"
  },
  {
    "start": 345.598,
    "end": 348.308,
    "text": "توی زندگی‌نامه‌ش از\nیه دفترچه کوچیک می‌گه"
  },
  {
    "start": 348.455,
    "end": 349.872,
    "text": "برای بهتر شدن خودش"
  },
  {
    "start": 349.912,
    "end": 352.076,
    "text": "سیزده ویژگی رو انتخاب کرده بود"
  },
  {
    "start": 352.116,
    "end": 353.419,
    "text": "مثل نظم، میانه‌روی"
  },
  {
    "start": 353.459,
    "end": 354.674,
    "text": "پشتکار و صداقت"
  },
  {
    "start": 354.822,
    "end": 357.332,
    "text": "و هر هفته فقط روی یکی تمرکز می‌کرد"
  },
  {
    "start": 357.48,
    "end": 359.052,
    "text": "بقیه رو فراموش نمی‌کرد"
  },
  {
    "start": 359.092,
    "end": 360.609,
    "text": "ولی توجه اصلیش اون هفته"
  },
  {
    "start": 360.649,
    "end": 362.029,
    "text": "روی همون یکی بود"
  },
  {
    "start": 362.176,
    "end": 364.671,
    "text": "هر شب هم نگاه می‌کرد\nچند بار لغزیده"
  },
  {
    "start": 364.711,
    "end": 366.361,
    "text": "و یه نشونه ثبت می‌کرد"
  },
  {
    "start": 366.84,
    "end": 368.573,
    "text": "و نکته جالبش اینه که به‌جای"
  },
  {
    "start": 368.613,
    "end": 370.778,
    "text": "اینکه بنویسه چی باید یاد بگیرم"
  },
  {
    "start": 370.818,
    "end": 372.188,
    "text": "لغزش‌هاش رو می‌نوشت"
  },
  {
    "start": 372.336,
    "end": 374.359,
    "text": "دلیلش هم یه تشبیه ساده بود"
  },
  {
    "start": 374.507,
    "end": 377.122,
    "text": "مثل باغبونی که باغچه\nپر از علف داره"
  },
  {
    "start": 377.269,
    "end": 379.599,
    "text": "اگه بخواد همه علف‌ها رو یه‌جا بکنه"
  },
  {
    "start": 379.639,
    "end": 380.853,
    "text": "از پسش برنمیاد"
  },
  {
    "start": 381.001,
    "end": 383.512,
    "text": "پس هر بار سراغ یه تیکه باغچه می‌ره"
  },
  {
    "start": 384.321,
    "end": 386.822,
    "text": "حالا بذار روشش رو برات کاربردی کنم"
  },
  {
    "start": 386.97,
    "end": 388.246,
    "text": "سه تا قدم داره"
  },
  {
    "start": 388.724,
    "end": 389.621,
    "text": "قدم اول"
  },
  {
    "start": 389.661,
    "end": 391.301,
    "text": "همه علاقه‌هات رو بنویس"
  },
  {
    "start": 391.449,
    "end": 392.709,
    "text": "ولی برای یک ماه"
  },
  {
    "start": 392.749,
    "end": 394.825,
    "text": "فقط یه پروژه اصلی انتخاب کن"
  },
  {
    "start": 394.972,
    "end": 396.337,
    "text": "مثلا اگه به نوشتن"
  },
  {
    "start": 396.377,
    "end": 398.376,
    "text": "روانشناسی و تدوین علاقه داری"
  },
  {
    "start": 398.416,
    "end": 401.655,
    "text": "پروژه‌ت می‌تونه ساختن یه\nویدیوی آموزشی کوتاه باشه"
  },
  {
    "start": 402.133,
    "end": 403.03,
    "text": "قدم دوم"
  },
  {
    "start": 403.07,
    "end": 404.647,
    "text": "هر هفته روی یه بخش مشخص"
  },
  {
    "start": 404.687,
    "end": 406.441,
    "text": "از همون پروژه تمرکز کن"
  },
  {
    "start": 406.589,
    "end": 407.736,
    "text": "هفته اول تحقیق"
  },
  {
    "start": 407.776,
    "end": 409.193,
    "text": "هفته دوم نوشتن متن"
  },
  {
    "start": 409.233,
    "end": 410.588,
    "text": "هفته سوم تصویرسازی"
  },
  {
    "start": 410.628,
    "end": 411.947,
    "text": "هفته چهارم تدوین"
  },
  {
    "start": 412.094,
    "end": 414.108,
    "text": "لازم نیست دقیقا همین‌ها باشه"
  },
  {
    "start": 414.256,
    "end": 416.041,
    "text": "فقط تقسیمش کن تا ببینی کدوم"
  },
  {
    "start": 416.081,
    "end": 417.939,
    "text": "بخش بیشتر به دردت می‌خوره"
  },
  {
    "start": 418.418,
    "end": 419.314,
    "text": "قدم سوم"
  },
  {
    "start": 419.354,
    "end": 421.473,
    "text": "از دفترچه فرانکلین الهام بگیر"
  },
  {
    "start": 421.62,
    "end": 423.197,
    "text": "هر شب یادداشت کن چی خوب"
  },
  {
    "start": 423.237,
    "end": 425.209,
    "text": "پیش رفت و کجا اشتباه کردی"
  },
  {
    "start": 425.356,
    "end": 426.877,
    "text": "یه دفترچه ساده کافیه"
  },
  {
    "start": 426.917,
    "end": 428.277,
    "text": "یا یه گروه خصوصی توی"
  },
  {
    "start": 428.317,
    "end": 430.227,
    "text": "پیام‌رسان که فقط خودت توشی"
  },
  {
    "start": 430.375,
    "end": 432.658,
    "text": "حتی اشتباه‌های کوچیک رو هم بنویس"
  },
  {
    "start": 432.806,
    "end": 434.829,
    "text": "مثلا یه چیزی رو گرون خریدی"
  },
  {
    "start": 434.977,
    "end": 437.8,
    "text": "بنویس، قبل از خرید\nباید بیشتر تحقیق کنم"
  },
  {
    "start": 437.947,
    "end": 439.919,
    "text": "یه هفته بعد هم هنوز یادته"
  },
  {
    "start": 440.066,
    "end": 442.723,
    "text": "همین یادآوری، دفعه\nبعد دستت رو می‌گیره"
  },
  {
    "start": 443.202,
    "end": 444.102,
    "text": "یه هشدار"
  },
  {
    "start": 444.19,
    "end": 447.169,
    "text": "این دفترچه نباید تبدیل\nبشه به سرگرمی جدیدت"
  },
  {
    "start": 447.317,
    "end": 449.116,
    "text": "هدف اینه که کار پیش بره"
  },
  {
    "start": 449.156,
    "end": 450.464,
    "text": "نه اینکه سه ساعت یه"
  },
  {
    "start": 450.504,
    "end": 452.093,
    "text": "جدول خوشگل طراحی کنی"
  },
  {
    "start": 452.24,
    "end": 454.929,
    "text": "حتی خود فرانکلین هم\nاعتراف کرد اجرای نقشه‌ش"
  },
  {
    "start": 454.969,
    "end": 457.195,
    "text": "سخت‌تر از چیزی بود که فکر می‌کرد"
  },
  {
    "start": 457.235,
    "end": 458.18,
    "text": "مخصوصا نظم"
  },
  {
    "start": 458.327,
    "end": 459.977,
    "text": "و این خودش خبر خوبیه"
  },
  {
    "start": 460.125,
    "end": 461.811,
    "text": "یعنی اگه گاهی جا موندی"
  },
  {
    "start": 461.851,
    "end": 463.18,
    "text": "مشکل از تو نیست"
  },
  {
    "start": 463.327,
    "end": 465.549,
    "text": "باید واقع‌بینانه ازش استفاده کنی"
  },
  {
    "start": 466.359,
    "end": 468.321,
    "text": "ولی یه سؤال نیمه‌تموم مونده"
  },
  {
    "start": 468.468,
    "end": 470.088,
    "text": "علاقه‌های ما حتما باید توی"
  },
  {
    "start": 470.128,
    "end": 471.457,
    "text": "یه شغل جمع بشن؟"
  },
  {
    "start": 471.604,
    "end": 472.179,
    "text": "نه"
  },
  {
    "start": 472.219,
    "end": 473.896,
    "text": "امیلی واپنیک، توی کتابش"
  },
  {
    "start": 473.936,
    "end": 475.742,
    "text": "چهار مدل رو معرفی می‌کنه"
  },
  {
    "start": 475.889,
    "end": 477.301,
    "text": "و جالبه که نمی‌گه حتما"
  },
  {
    "start": 477.341,
    "end": 479.251,
    "text": "همه مهارت‌هات رو ترکیب کنی"
  },
  {
    "start": 479.73,
    "end": 481.266,
    "text": "مدل اول، آغوش گروهی"
  },
  {
    "start": 481.413,
    "end": 484.08,
    "text": "چند علاقه مختلف توی\nیه حرفه جمع می‌شن"
  },
  {
    "start": 484.228,
    "end": 485.914,
    "text": "مثلا کسی که طراحی بلده"
  },
  {
    "start": 485.954,
    "end": 488.846,
    "text": "برنامه‌نویسی خونده و\nروانشناسی رفتاری می‌شناسه"
  },
  {
    "start": 488.886,
    "end": 491.378,
    "text": "می‌تونه وارد طراحی\nمحصول دیجیتال بشه"
  },
  {
    "start": 491.526,
    "end": 492.938,
    "text": "هر سه مهارتش توی همون"
  },
  {
    "start": 492.978,
    "end": 494.41,
    "text": "پروژه به کار می‌اد"
  },
  {
    "start": 494.557,
    "end": 496.882,
    "text": "برای تست، یه مسئله\nپیدا کن که حداقل"
  },
  {
    "start": 496.922,
    "end": 499.059,
    "text": "با دو تا از علاقه‌هات حل بشه"
  },
  {
    "start": 499.538,
    "end": 500.633,
    "text": "مدل دوم، اسلش"
  },
  {
    "start": 500.673,
    "end": 502.261,
    "text": "یا همون شغل‌های موازی"
  },
  {
    "start": 502.409,
    "end": 504.858,
    "text": "بعضی علاقه‌ها اصلا به هم ربط ندارن"
  },
  {
    "start": 505.005,
    "end": 506.905,
    "text": "مثلا کسی سه روز هفته معلمه و"
  },
  {
    "start": 506.945,
    "end": 509.498,
    "text": "بقیه هفته عکاسی یا\nموسیقی کار می‌کنه"
  },
  {
    "start": 509.645,
    "end": 511.607,
    "text": "لازم نیست زورکی وصلشون کنی"
  },
  {
    "start": 511.755,
    "end": 513.436,
    "text": "فقط حواست باشه که این مدل"
  },
  {
    "start": 513.476,
    "end": 515.953,
    "text": "برنامه‌ریزی و مدیریت\nمالی خوبی می‌خواد"
  },
  {
    "start": 515.993,
    "end": 518.13,
    "text": "و نباید یکی دیگه رو خفه کنه"
  },
  {
    "start": 518.608,
    "end": 519.927,
    "text": "مدل سوم، اینشتین"
  },
  {
    "start": 520.074,
    "end": 522.472,
    "text": "برای کسی که امنیت مالی براش مهمه"
  },
  {
    "start": 522.619,
    "end": 523.927,
    "text": "یه شغل اصلی داری که"
  },
  {
    "start": 523.967,
    "end": 525.28,
    "text": "خرجت رو در می‌اره"
  },
  {
    "start": 525.32,
    "end": 528.299,
    "text": "و کنارش وقت کافی برای\nبقیه علاقه‌هات می‌ذاری"
  },
  {
    "start": 528.446,
    "end": 530.709,
    "text": "اینشتین هم توی اداره\nثبت اختراع کار"
  },
  {
    "start": 530.749,
    "end": 533.251,
    "text": "می‌کرد و فیزیک رو\nکنارش دنبال می‌کرد"
  },
  {
    "start": 533.398,
    "end": 536.117,
    "text": "لازم نیست هر علاقه‌ای\nبه پول تبدیل بشه"
  },
  {
    "start": 536.264,
    "end": 538.093,
    "text": "می‌تونی برنامه‌نویس باشی و شب‌ها"
  },
  {
    "start": 538.133,
    "end": 539.773,
    "text": "با تلسکوپ آسمون ببینی"
  },
  {
    "start": 540.252,
    "end": 541.57,
    "text": "مدل چهارم، ققنوس"
  },
  {
    "start": 541.718,
    "end": 543.891,
    "text": "چند سال روی یه حرفه عمیق می‌شی"
  },
  {
    "start": 543.931,
    "end": 545.566,
    "text": "به یه تجربه جدی می‌رسی"
  },
  {
    "start": 545.606,
    "end": 547.577,
    "text": "و بعد می‌ری سراغ حوزه دیگه"
  },
  {
    "start": 547.725,
    "end": 549.614,
    "text": "این مدل کلاسیکه و احتمالا چند"
  },
  {
    "start": 549.654,
    "end": 551.938,
    "text": "نفر رو می‌شناسی که همین‌جوری رفتن"
  },
  {
    "start": 552.085,
    "end": 553.144,
    "text": "فقط یه نکته"
  },
  {
    "start": 553.291,
    "end": 554.708,
    "text": "توی عصر هوش مصنوعی"
  },
  {
    "start": 554.748,
    "end": 556.493,
    "text": "یادگیری خیلی سریع‌تر شده"
  },
  {
    "start": 556.64,
    "end": 559.343,
    "text": "مهارتی که قبلا شاید\nچند سال طول می‌کشید"
  },
  {
    "start": 559.383,
    "end": 561.563,
    "text": "حالا ممکنه خیلی زودتر جلو بره"
  },
  {
    "start": 561.71,
    "end": 564.264,
    "text": "پس چرخه ققنوس هم\nمی‌تونه کوتاه‌تر بشه"
  },
  {
    "start": 565.073,
    "end": 566.775,
    "text": "خب کدوم مدل مال توئه؟"
  },
  {
    "start": 566.923,
    "end": 569.268,
    "text": "واپنیک سه تا نیاز رو مطرح می‌کنه"
  },
  {
    "start": 569.415,
    "end": 570.796,
    "text": "پول، معنا و تنوع"
  },
  {
    "start": 570.943,
    "end": 572.054,
    "text": "از خودت بپرس"
  },
  {
    "start": 572.201,
    "end": 574.163,
    "text": "چقدر درآمد ثابت لازم دارم؟"
  },
  {
    "start": 574.311,
    "end": 576.698,
    "text": "چقدر می‌خوام کارم معنا داشته باشه؟"
  },
  {
    "start": 576.846,
    "end": 578.756,
    "text": "و واقعا چقدر تنوع می‌خوام؟"
  },
  {
    "start": 579.234,
    "end": 580.911,
    "text": "اگه امنیت مالی اولویتته"
  },
  {
    "start": 580.951,
    "end": 582.705,
    "text": "از مدل اینشتین شروع کن"
  },
  {
    "start": 582.852,
    "end": 585.338,
    "text": "اگه برون‌گرایی و\nدوست داری چند مهارت"
  },
  {
    "start": 585.378,
    "end": 587.916,
    "text": "مخصوصا اجتماعی، رو\nبا هم استفاده کنی"
  },
  {
    "start": 587.956,
    "end": 589.762,
    "text": "آغوش گروهی رو امتحان کن"
  },
  {
    "start": 589.909,
    "end": 592.291,
    "text": "اگه از چند کار مستقل انرژی می‌گیری"
  },
  {
    "start": 592.331,
    "end": 593.276,
    "text": "اسلش بهتره"
  },
  {
    "start": 593.423,
    "end": 595.271,
    "text": "و اگه ترجیح می‌دی هر دوره از"
  },
  {
    "start": 595.311,
    "end": 597.803,
    "text": "زندگیت تمرکز عمیق\nداشته باشی، ققنوس"
  },
  {
    "start": 598.281,
    "end": 599.983,
    "text": "حالا یه کار کوچیک بکن"
  },
  {
    "start": 600.13,
    "end": 602.186,
    "text": "دو هفته، مدلی که انتخاب کردی رو"
  },
  {
    "start": 602.226,
    "end": 604.229,
    "text": "توی یه مقیاس کوچیک آزمایش کن و"
  },
  {
    "start": 604.269,
    "end": 606.874,
    "text": "ببین با زندگی واقعیت\nچقدر جور درمیاد"
  },
  {
    "start": 607.353,
    "end": 609.257,
    "text": "اگه این ویدیو بهت کمک کرد"
  },
  {
    "start": 609.297,
    "end": 610.677,
    "text": "سه کار کوچیک بکن"
  },
  {
    "start": 610.824,
    "end": 611.883,
    "text": "لایک رو بزن"
  },
  {
    "start": 612.03,
    "end": 614.459,
    "text": "ویدیو رو برای دوستی\nبفرست که همیشه ده"
  },
  {
    "start": 614.499,
    "end": 617.426,
    "text": "تا علاقه داره و نمی‌دونه\nباهاشون چیکار کنه"
  },
  {
    "start": 617.574,
    "end": 619.359,
    "text": "سرک رو سابسکرایب کن تا برای"
  },
  {
    "start": 619.399,
    "end": 621.205,
    "text": "ویدیوی بعدی هم سرک بکشی"
  },
  {
    "start": 621.353,
    "end": 622.717,
    "text": "و زیر ویدیو بنویس"
  },
  {
    "start": 622.757,
    "end": 624.781,
    "text": "کدوم مدل به نظرت مال توئه؟"
  },
  {
    "start": 624.928,
    "end": 626.18,
    "text": "آغوش گروهی، اسلش"
  },
  {
    "start": 626.22,
    "end": 627.591,
    "text": "اینشتین یا ققنوس؟"
  }
]